{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tacot Edit",
  "version": "0.2.2",
  "identifier": "app.tacot.edit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tacot Edit",
        "width": 1560,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 720,
        "theme": "Dark",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["bin/speech/*", "bin/ffmpeg/*", "LICENSE.txt"]
  }
}
